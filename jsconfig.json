{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "assets/**/*.js",
    "tools/*.js",
    "tools/*.cjs"
  ],
  "exclude": [
    "node_modules",
    ".backups",
    "tools/legacy"
  ]
}
